// Publicación en Cloudflare (Worker con archivos estáticos): `npm run deploy`.
// Solo se sube dist/, que prepara scripts/preparar-dist.mjs con los archivos de la web.
{
  "name": "firmador-documentos",
  "compatibility_date": "2026-09-18",
  "assets": { "directory": "./dist" },
  "workers_dev": true,
  // Sin direcciones de vista previa por versión: no pasarían por el control de acceso
  "preview_urls": false,

  // El servidor de la carpeta compartida de ITA. Solo atiende las direcciones /api/...; el resto
  // (index.html, js/, plantillas/…) lo sirve Cloudflare directamente desde dist/ sin pasar por aquí.
  "main": "worker/index.js",

  // La base de datos donde viven los ITA compartidos. Está creada con jurisdicción "eu", que no
  // es una preferencia sino una obligación: Cloudflare no puede guardarla ni procesarla fuera de
  // la Unión Europea. Eso no se puede cambiar después, hay que crear la base ya con esa condición.
  // Las tablas se crean con `npm run esquema`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firmador-itas-eu",
      "database_id": "8632dabe-ee55-412e-b713-aa44ccbf3193"
    }
  ],

  // Quién puede quitar un ITA de la carpeta compartida. Los demás solo suben y consultan.
  "vars": {
    "CORREOS_ADMIN": "adrianbdcabo@gmail.com"
  },

  // Limpieza automática cada madrugada (3:00 en hora universal): borra los ITA de más de 10 días
  // y el rastro de accesos de más de 90.
  "triggers": {
    "crons": ["0 3 * * *"]
  },

  // Registros del servidor. Se dejan encendidos para poder ver si algo falla, pero el código se
  // encarga de que en ellos no aparezca nunca ningún dato de ninguna persona.
  "observability": {
    "enabled": true
  }
}
