    "fast-png": "^8.0.0",
    "http-server": "^14.1.1",
    "jpeg-js": "^0.4.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "wrangler": "^4.135.0"
  }
